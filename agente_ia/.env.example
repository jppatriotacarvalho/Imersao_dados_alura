# ==============================================================================
# CONFIGURAÇÃO DO AGENTE DE TEXTO -> SQL (Fase 4 - VoeBem)
# Copie este arquivo como .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Conexão Databricks SQL Warehouse (Free Edition)
# No Databricks: SQL Warehouses -> selecione seu warehouse -> Connection details
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=voebem

# Chave de API do Google Gemini
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo do Gemini. O Google desliga modelos antigos de tempos em tempos —
# quando isso acontecer, troque só esta linha.
# Lista atual: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.7-flash
# Usado uma única vez, só se o modelo acima estiver sobrecarregado (erro 503 do Google).
GEMINI_MODEL_RESERVA=gemini-3.5-flash
